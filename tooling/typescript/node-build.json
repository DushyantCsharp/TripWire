{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./node.json",
  "compilerOptions": {
    "noEmit": false,
    "customConditions": [],
    "rootDir": "${configDir}/src",
    "outDir": "${configDir}/dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["${configDir}/src"],
  "exclude": ["${configDir}/src/**/*.test.ts"]
}
