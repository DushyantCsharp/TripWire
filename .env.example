# Copy to .env. Apps load it via --env-file-if-exists; just recipes via dotenv-load.
# Host ports match infra/docker-compose.yml defaults (see infra/README.md).

DATABASE_URL=postgres://tripwire:tripwire@localhost:15432/tripwire
REDIS_URL=redis://localhost:16379
# OpenTelemetry (packages/telemetry, loaded with --import): traces and metrics to Tripwire's own
# collector. Unset it, or set OTEL_SDK_DISABLED=true, to run untraced.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14318
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# OTEL_METRIC_EXPORT_INTERVAL=15000
# Prompts, completions and tool results on the triage spans: off, they hold incident data.
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false

# Expand/contract flags for alerts.fingerprint_v2 (packages/db/MIGRATIONS.md)
FINGERPRINT_V2_WRITE=true
FINGERPRINT_V2_READ=true

API_PORT=4000
# Webhook HMAC secrets, comma-separated, 16+ characters each. All of them verify, so a secret can
# rotate: add the new one, move senders over, then remove the old one.
WEBHOOK_SECRETS=local-dev-webhook-secret
# Ingest returns 503 + Retry-After while more than this many ingest jobs are waiting.
INGEST_HIGH_WATER=10000
# BullMQ key prefix; api and worker must agree.
QUEUE_PREFIX=bull

# Worker: triage gets 5 attempts with full-jitter backoff, rate-limited per minute. In-flight jobs
# drain on SIGTERM for SHUTDOWN_TIMEOUT_MS.
TRIAGE_MAX_PER_MINUTE=30
TRIAGE_BACKOFF_BASE_MS=2000
TRIAGE_BACKOFF_CAP_MS=60000
# Longer than a triage run's 60 s wall clock, so a deploy doesn't cancel runs mid-flight.
SHUTDOWN_TIMEOUT_MS=75000

# Triage: `claude` runs the tool-use loop and needs a key; `baseline` (the default) ranks services by
# alert labels without a model. Each run: 8 tool calls, 40k in / 4k out tokens, 60 s.
TRIAGER=baseline
# ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-opus-5-5
TRIAGE_EFFORT=low
TRIAGE_WALL_CLOCK_MS=60000
# The telemetry the tools read: the OTel demo's backends (`just demo-up`). Unset ones are reported
# as unavailable evidence. DEPLOYS_URL is a change feed (see httpChangeSource); without it
# list_deploys isn't offered.
LOGS_OPENSEARCH_URL=http://localhost:29200
TRACES_JAEGER_URL=http://localhost:26686/jaeger/ui
METRICS_PROMETHEUS_URL=http://localhost:9090
# DEPLOYS_URL=

# Golden-set capture (`just eval-capture`): the demo's endpoints.
DEMO_URL=http://localhost:8080
DEMO_PROMETHEUS_URL=http://localhost:9090
DEMO_JAEGER_URL=http://localhost:26686/jaeger/ui
DEMO_OPENSEARCH_URL=http://localhost:29200
# Evals: a Postgres (pgvector) to use instead of starting one, e.g. `just infra-up`'s.
# EVAL_DATABASE_URL=postgres://tripwire:tripwire@localhost:15432/tripwire
# Console: the API's GraphQL endpoint, read per request (one image serves any deployment).
GRAPHQL_URL=http://localhost:4000/graphql
