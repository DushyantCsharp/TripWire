{
  "name": "tripwire",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "generate": "turbo run generate",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:all": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest",
    "coverage": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest --coverage",
    "check": "turbo run lint typecheck check:generated && pnpm coverage && pnpm check:boundaries && pnpm format:check && pnpm test:scripts",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:scripts": "node --test 'scripts/**/*.test.mjs'",
    "check:contracts": "turbo run check:generated",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf .turbo"
  },
  "prettier": "@tripwire/prettier-config",
  "devDependencies": {
    "@jest/globals": "catalog:",
    "@tripwire/jest-config": "workspace:*",
    "@tripwire/prettier-config": "workspace:*",
    "jest": "catalog:",
    "jest-junit": "^16.0.0",
    "prettier": "catalog:",
    "turbo": "catalog:"
  }
}
