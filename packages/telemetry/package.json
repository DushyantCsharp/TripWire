{
  "name": "@tripwire/telemetry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@tripwire/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "@tripwire/source": "./src/register.ts",
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./testing": {
      "@tripwire/source": "./src/testing.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "lint": "eslint .",
    "test": "NODE_OPTIONS='--experimental-vm-modules --disable-warning=ExperimentalWarning' jest",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@jest/globals": "catalog:",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/sdk-trace": "^2.12.0",
    "@tripwire/eslint-config": "workspace:*",
    "@tripwire/jest-config": "workspace:*",
    "@tripwire/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jest": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@fastify/otel": "^0.21.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-ioredis": "^0.71.0",
    "@opentelemetry/instrumentation-pg": "^0.75.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@tripwire/config": "workspace:*",
    "@tripwire/result": "workspace:*",
    "zod": "catalog:"
  }
}
